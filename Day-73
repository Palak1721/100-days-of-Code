/*We use hashing to count the frequency of each character.

Steps:
1. Traverse the string once and store frequency of each character
2. Traverse the string again
3. First character with frequency 1 is the answer
4. If no such character exists, print '$'*/

#include <stdio.h>
#include <string.h>

int main() {
    char s[1000];
    int freq[26] = {0};
    int found = 0;

    scanf("%s", s);

    for(int i = 0; s[i] != '\0'; i++) {
        freq[s[i] - 'a']++;
    }

    for(int i = 0; s[i] != '\0'; i++) {
        if(freq[s[i] - 'a'] == 1) {
            printf("%c", s[i]);
            found = 1;
            break;
        }
    }

    if(!found)
        printf("$");

    return 0;
}
